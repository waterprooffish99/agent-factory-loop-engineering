{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {"type": "string", "enum": ["PASS", "FAIL"]},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
